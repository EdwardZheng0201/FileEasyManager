<StackPanel Orientation="Horizontal">
<TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xEDA2;" Margin="0,0,8,0"/>
<TextBlock Text="Data (D:)"/>
</StackPanel>
</Button>
<ProgressBar Value="40" Height="14" Margin="4,8,4,4"/>
<TextBlock Text="Example: 300 GB used / 750 GB total"/>
</StackPanel>
</UniformGrid>
<!-- ================= Recent Items ================= -->
<Grid>
<Grid.ColumnDefinitions>
<ColumnDefinition/>
<ColumnDefinition/>
</Grid.ColumnDefinitions>
<StackPanel Grid.Column="0" Margin="4">
<TextBlock Text="Recent Folders"/>
<Separator/>
<ListView x:Name="RecentFolders" Height="220" Margin="0,8,0,0" MouseDoubleClick="Recent_DoubleClick" ContextMenu="{StaticResource FileMenu}" PreviewMouseRightButtonDown="List_RightClick" dd:DragDrop.IsDragSource="True" dd:DragDrop.UseDefaultDragAdorner="True" dd:DragDrop.DragAdornerTemplate="{StaticResource DragPreviewTemplate}" dd:DragDrop.DragHandler="{Binding QuickMoveDragHandler, ElementName=MainWindowRoot}">
<ListView.View>
<GridView>
<GridViewColumn Header="Name" Width="145" DisplayMemberBinding="{Binding Name}"/>
<GridViewColumn Header="Path" Width="125" DisplayMemberBinding="{Binding Path}"/>
<GridViewColumn Header="Date modified" Width="145" DisplayMemberBinding="{Binding Modified}"/>
</GridView>
</ListView.View>
</ListView>
</StackPanel>
<StackPanel Grid.Column="1" Margin="4">
<TextBlock Text="Recent Files / Programs"/>
<Separator/>
<ListView x:Name="RecentFiles" Height="220" Margin="0,8,0,0" MouseDoubleClick="Recent_DoubleClick" ContextMenu="{StaticResource FileMenu}" PreviewMouseRightButtonDown="List_RightClick" dd:DragDrop.IsDragSource="True" dd:DragDrop.UseDefaultDragAdorner="True" dd:DragDrop.DragAdornerTemplate="{StaticResource DragPreviewTemplate}" dd:DragDrop.DragHandler="{Binding QuickMoveDragHandler, ElementName=MainWindowRoot}">
<ListView.View>
<GridView>
<GridViewColumn Header="Name" Width="145" DisplayMemberBinding="{Binding Name}"/>
<GridViewColumn Header="Path" Width="125" DisplayMemberBinding="{Binding Path}"/>
<GridViewColumn Header="Date modified" Width="145" DisplayMemberBinding="{Binding Modified}"/>
</GridView>
</ListView.View>
</ListView>
</StackPanel>
</Grid>
</StackPanel>
</ScrollViewer>
<DockPanel x:Name="FolderView">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
<TextBlock x:Name="FolderTitle"/>
<TextBlock x:Name="SortLabel" HorizontalAlignment="Right"/>
</DockPanel>
    <Grid>
     <!-- ============================== Folder View - File List, Multiple Selection and Sorting ============================== -->
     <ListView x:Name="FileList" SelectionMode="Extended" SelectionChanged="Selection_Changed" MouseDoubleClick="Files_DoubleClick" KeyDown="Files_KeyDown" GridViewColumnHeader.Click="Sort_Click" ContextMenu="{StaticResource FileMenu}" PreviewMouseRightButtonDown="List_RightClick" dd:DragDrop.IsDragSource="True" dd:DragDrop.UseDefaultDragAdorner="True" dd:DragDrop.DragAdornerTemplate="{StaticResource DragPreviewTemplate}" dd:DragDrop.DragHandler="{Binding QuickMoveDragHandler, ElementName=MainWindowRoot}">
      <ListView.View>
<GridView AllowsColumnReorder="False">
       <GridViewColumn Header="Name" Width="290">
<GridViewColumn.CellTemplate>
<DataTemplate>
<StackPanel Orientation="Horizontal">
<TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Text="{Binding Icon}" VerticalAlignment="Center" Margin="0,0,6,0"/>
<TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
</StackPanel>
</DataTemplate>
</GridViewColumn.CellTemplate>
</GridViewColumn>
       <GridViewColumn Header="Type" Width="145" DisplayMemberBinding="{Binding Type}"/>
       <GridViewColumn Header="Date modified" Width="165" DisplayMemberBinding="{Binding Modified}"/>
       <GridViewColumn Header="Size" Width="100" DisplayMemberBinding="{Binding SizeText}"/>
      </GridView>
</ListView.View>
     </ListView>
     <!-- ============================== Folder View - Empty Folder Message ============================== -->
     <TextBlock x:Name="EmptyLabel" Text="This folder is empty." HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
    </Grid>
   </DockPanel>
</Grid>
  </Grid>
 </DockPanel>
</Window>
