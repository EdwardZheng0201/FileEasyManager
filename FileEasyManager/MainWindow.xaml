    <!-- ================= Sidebar - Pinned Locations ================= -->
    <TextBlock Text="Pinned Locations" Margin="0,8,0,4"/>
    <ItemsControl ItemsSource="{Binding PinnedLocations, ElementName=MainWindowRoot}" ItemTemplate="{StaticResource PinnedTemplate}"/>
    <Separator Margin="0,4,0,8"/><Separator Margin="0,12,0,12"/>
<Button Tag="This PC" Click="Location_Click" AllowDrop="True" DragOver="Move_SidebarOver" DragLeave="Move_TargetLeave" Drop="Move_SidebarDrop" ContextMenu="{StaticResource LocationMenu}" HorizontalContentAlignment="Left" Padding="6" Margin="0,0,4,4" >
<StackPanel Orientation="Horizontal">
<TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE7F4;" Margin="0,0,8,0"/>
<TextBlock Text="This PC"/>
</StackPanel>
</Button>
<Button Tag="C:\" Click="Location_Click" AllowDrop="True" DragOver="Move_SidebarOver" DragLeave="Move_TargetLeave" Drop="Move_SidebarDrop" ContextMenu="{StaticResource LocationMenu}" HorizontalContentAlignment="Left" Padding="6" Margin="0,0,4,4" >
<StackPanel Orientation="Horizontal">
