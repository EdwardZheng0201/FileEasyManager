<StackPanel Orientation="Horizontal">
<TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8B7;" Margin="0,0,8,0"/>
<TextBlock Text="Documents"/>
</StackPanel>
</Button>
<Button Tag="C:\Pictures" Click="Location_Click" AllowDrop="True" DragOver="Move_SidebarOver" DragLeave="Move_TargetLeave" Drop="Move_SidebarDrop" ContextMenu="{StaticResource LocationMenu}" HorizontalContentAlignment="Left" Padding="6" Margin="0,0,4,4" >
<StackPanel Orientation="Horizontal">
